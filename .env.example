# =============================================================================
# Explainable Multi-Source SME Financial Distress Early-Warning System
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local or production environment.
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS TO VERSION CONTROL.
# =============================================================================

# Service Environment Mode (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Administrative API Authentication Key
# Required to trigger /admin/reload-db cache invalidation.
# If unset, administrative endpoints fail closed with HTTP 503 Service Unavailable.
ADMIN_API_KEY=your_secure_admin_api_key_placeholder_here

# Streamlit Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Data & Model Directories (defaults relative to repository root)
DATA_RAW_PATH=data/raw/Financial Distress.csv
PROCESSED_DB_PATH=data/processed/companies_risk_intelligence.json
WATCHLIST_PATH=data/processed/watchlist.csv
APPROVED_MODEL_PATH=models/phase2/best_ews_model.joblib
APPROVED_CALIBRATOR_PATH=models/phase2/ews_calibrator.joblib
APPROVED_PREPROCESSOR_PATH=models/phase2/ews_preprocessor.joblib
THRESHOLD_CONFIG_PATH=models/phase2/threshold_config.json
RISK_CONFIG_PATH=config/risk_config.yaml
